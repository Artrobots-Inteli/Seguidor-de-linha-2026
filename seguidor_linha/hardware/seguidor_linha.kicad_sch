	(text "Alimentação: 5 V pelo USB do DevKit (regulador gera +3V3).\nMotores: bateria 6 V separada, GND comum com a ESP32.\nCada TB6612: canais A e B em paralelo (mesmo PWM/IN1/IN2 por lado).\nPull-up 10k nos encoders D (pinos 34/35 sem pull-up interno)." (exclude_from_sim no) (at 30 25 0) (effects (font (size 2 2)) (justify left)) (uuid "3849d658-bc98-430a-a4e2-ead9d65a16ff"))
